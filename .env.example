# Copy to .env and fill in your values
# docker compose --env-file .env up -d

# Required on first run to bootstrap admin user
NIRAPODNET_ADMIN_USERNAME=admin
NIRAPODNET_ADMIN_PASSWORD=changeme-strong-password

# Required: long random secret for signing tokens (generate with: openssl rand -hex 32)
NIRAPODNET_SIGNING_KEY=

# Optional: database URL (default uses SQLite in volume)
# NIRAPODNET_DB=sqlite:////app/data/nirapodnet.db

# Optional: enable HTTPS (requires certs in ./certs/ and docker-compose.tls.yml)
# NIRAPODNET_HTTPS=1